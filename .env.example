# ── Banco de dados (Prisma → Supabase PostgreSQL) ────────────
# Com PgBouncer (produção): acrescente ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────
APP_ENV=local
API_PORT=3000
CORS_ORIGINS=http://localhost:4200
# Produção: CORS_ORIGINS=https://nossobolao.vercel.app

# ── Supabase JWT ──────────────────────────────────────────────
SUPABASE_JWT_SECRET=your-jwt-secret

# ── GitHub Actions Secrets (não vão para .env — apenas referência) ──────────
# FLY_API_TOKEN        → fly auth token
# VERCEL_TOKEN         → Vercel Account → Settings → Tokens
# VERCEL_ORG_ID        → .vercel/project.json após `vercel link`
# VERCEL_PROJECT_ID    → .vercel/project.json após `vercel link`

# ── Redis (Upstash Free) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google Sheets (Service Account) ──────────────────────────
# Recomendado: salve o JSON exportado do Google Cloud em secrets/
# (a pasta inteira está no .gitignore — nunca commite credenciais)
#
# Como obter:
#  1. console.cloud.google.com → IAM → Service Accounts → Keys → Add Key (JSON)
#  2. Mova o arquivo baixado para secrets/google-service-account.json
#  3. Compartilhe a planilha com o client_email do JSON (Editor)
GOOGLE_SA_KEY_PATH=./secrets/google-service-account.json

# Alternativa LEGADA (não recomendada — pode confundir parsers de .env):
# GOOGLE_SA_EMAIL=nome-sa@projeto.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
