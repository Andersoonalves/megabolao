# ── Banco de dados (Prisma → Supabase PostgreSQL) ────────────
# Com PgBouncer (produção): acrescente ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────
APP_ENV=local
API_PORT=3000
CORS_ORIGINS=http://localhost:4200

# ── Redis (Upstash Free) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google Sheets (Service Account) ──────────────────────────
# Criar service account em console.cloud.google.com → IAM → Service Accounts
# Compartilhar a planilha com o email da service account (Editor)
GOOGLE_SA_EMAIL=nome-sa@projeto.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
