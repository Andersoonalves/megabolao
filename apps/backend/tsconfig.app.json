{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "../../dist/apps/backend",
    "declaration": true,
    "types": ["node"]
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../libs/**/*.spec.ts",
    "../../libs/**/*.test.ts"
  ],
  "include": [
    "src/**/*.ts",
    "../../libs/shared-types/src/**/*.ts",
    "../../libs/shared-utils/src/**/*.ts"
  ]
}
