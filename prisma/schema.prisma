generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMs ─────────────────────────────────────────────────────

enum TenantStatus {
  ATIVO
  INATIVO
  SUSPENSO

  @@map("tenant_status")
}

enum BolaoStatus {
  A_SER_INICIADO
  EM_ANDAMENTO
  FINALIZADO

  @@map("bolao_status")
}

enum PapelUsuario {
  MASTER
  ADMIN

  @@map("papel_usuario")
}

enum CategoriaTipo {
  TAXA_ADMINISTRATIVA
  ACERTOS_EXATOS
  MAIOR_PONTUACAO_SORTEIO
  MAIOR_PONTUACAO_GERAL
  MENOR_PONTUACAO_GERAL

  @@map("categoria_tipo")
}

enum PagamentoStatus {
  PENDENTE
  PAGO
  INATIVO

  @@map("pagamento_status")
}

enum ResultadoStatus {
  EM_ANDAMENTO
  PREMIADO
  NAO_PREMIADO

  @@map("resultado_status")
}

enum MensagemTipo {
  RESULTADO_SORTEIO
  RANKING_PARCIAL
  PREMIADOS
  AVISO_ADMIN
  MANUAL

  @@map("mensagem_tipo")
}

enum MensagemStatus {
  PENDENTE
  ENVIADO
  FALHA

  @@map("mensagem_status")
}

enum AuditoriaSeveridade {
  INFO
  AVISO
  CRITICO

  @@map("auditoria_severidade")
}

// ── MODELS ─────────────────────────────────────────────────────

model Tenant {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                  String
  slug                  String       @unique
  status                TenantStatus @default(ATIVO)
  taxaAdministrativaPct Decimal      @default(15.00) @db.Decimal(5, 2) @map("taxa_administrativa_pct")
  branding              Json         @default("{}")
  sorteioAutoApply      Boolean      @default(false) @map("sorteio_auto_apply")
  sorteioUltimoIgnorado Int?         @map("sorteio_ultimo_ignorado")
  criadoEm              DateTime     @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm          DateTime     @default(now()) @db.Timestamptz() @map("atualizado_em")

  userProfiles        UserProfile[]
  boloes              Bolao[]
  categoriasPremiacao CategoriaPremiacao[]
  cotas               Cota[]
  sorteios            Sorteio[]
  acertosSorteio      AcertoSorteio[]
  premios             Premio[]
  mensagens           MensagemWhatsapp[]
  participantes       Participante[]
  perfis              Perfil[]
  modulosTenant       ModuloTenant[]
  auditorias          Auditoria[]
  whatsappTemplates   WhatsappTemplate[]
  crmEtapas           CrmEtapa[]
  crmContatos         CrmContato[]
  crmMensagens        CrmMensagem[]

  @@map("tenants")
}

model UserProfile {
  id           String       @id @db.Uuid
  tenantId     String?      @db.Uuid @map("tenant_id")
  papel        PapelUsuario
  celular      String?
  criadoEm     DateTime     @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm DateTime     @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("user_profiles")
}

model Bolao {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @db.Uuid @map("tenant_id")
  nome         String
  status       BolaoStatus @default(A_SER_INICIADO)
  valorCota    Decimal     @db.Decimal(10, 2) @map("valor_cota")
  dataInicio   DateTime?   @db.Date @map("data_inicio")
  dataTermino  DateTime?   @db.Date @map("data_termino")
  whatsappGrupos    Json      @default("[]") @map("whatsapp_grupos")
  sheetsSpreadsheetId String?   @map("sheets_spreadsheet_id")
  sheetsAtivo         Boolean   @default(false) @map("sheets_ativo")
  sheetsUltimaSyncAt  DateTime? @db.Timestamptz() @map("sheets_ultima_sync_at")
  sheetsUltimoErro    String?   @map("sheets_ultimo_erro")
  criadoEm     DateTime    @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm DateTime    @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  categoriasPremiacao CategoriaPremiacao[]
  cotas               Cota[]
  sorteios            Sorteio[]
  acertosSorteio      AcertoSorteio[]
  premios             Premio[]
  mensagens           MensagemWhatsapp[]

  @@map("boloes")
}

model CategoriaPremiacao {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @db.Uuid @map("tenant_id")
  bolaoId                String        @db.Uuid @map("bolao_id")
  nome                   String
  tipo                   CategoriaTipo
  acertosAlvo            Int?          @map("acertos_alvo")
  sorteioReferencia      Int?          @map("sorteio_referencia")
  percentual             Decimal       @db.Decimal(5, 2)
  acumulaSemGanhador     Boolean       @default(false) @map("acumula_sem_ganhador")
  valorAcumuladoAnterior Decimal       @default(0) @db.Decimal(12, 2) @map("valor_acumulado_anterior")
  ordem                  Int           @default(0)
  criadoEm               DateTime      @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm           DateTime      @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  bolao   Bolao    @relation(fields: [bolaoId], references: [id])
  premios Premio[]

  @@map("categorias_premiacao")
}

model Participante {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  nome          String
  numeroCelular String   @map("numero_celular")
  email         String?
  observacoes   String?
  criadoEm     DateTime @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm DateTime @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  cotas       Cota[]
  crmContatos CrmContato[]

  @@unique([tenantId, numeroCelular])
  @@map("participantes")
}

model Cota {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String          @db.Uuid @map("tenant_id")
  bolaoId                  String          @db.Uuid @map("bolao_id")
  participanteId           String?         @db.Uuid @map("participante_id")
  nomeIdentificacao        String          @map("nome_identificacao")
  numeroCelular            String?         @map("numero_celular")
  numeroSequencial         Int             @map("numero_sequencial")
  palpites                 Int[]
  statusPagamento          PagamentoStatus @default(PENDENTE) @map("status_pagamento")
  dataConfirmacaoPagamento DateTime?       @db.Timestamptz() @map("data_confirmacao_pagamento")
  totalAcertosAcumulados   Int             @default(0) @map("total_acertos_acumulados")
  statusResultado          ResultadoStatus @default(EM_ANDAMENTO) @map("status_resultado")
  criadoEm                 DateTime        @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm             DateTime        @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  bolao          Bolao           @relation(fields: [bolaoId], references: [id])
  participante   Participante?   @relation(fields: [participanteId], references: [id])
  acertosSorteio AcertoSorteio[]
  premios        Premio[]

  @@unique([tenantId, bolaoId, numeroSequencial])
  @@map("cotas")
}

model Sorteio {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid @map("tenant_id")
  bolaoId          String   @db.Uuid @map("bolao_id")
  numeroConcurso   Int      @map("numero_concurso")
  dataSorteio      DateTime @db.Date @map("data_sorteio")
  bolasSorteadas   Int[]    @map("bolas_sorteadas")
  sequenciaNoBolao Int      @map("sequencia_no_bolao")
  ehPrimeiro       Boolean  @default(false) @map("eh_primeiro")
  processado       Boolean  @default(false)
  criadoEm         DateTime @default(now()) @db.Timestamptz() @map("criado_em")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  bolao          Bolao           @relation(fields: [bolaoId], references: [id])
  acertosSorteio AcertoSorteio[]

  @@unique([tenantId, bolaoId, numeroConcurso])
  @@map("sorteios")
}

model AcertoSorteio {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  bolaoId   String   @db.Uuid @map("bolao_id")
  sorteioId String   @db.Uuid @map("sorteio_id")
  cotaId    String   @db.Uuid @map("cota_id")
  acertos   Int
  criadoEm  DateTime @default(now()) @db.Timestamptz() @map("criado_em")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  bolao   Bolao   @relation(fields: [bolaoId], references: [id])
  sorteio Sorteio @relation(fields: [sorteioId], references: [id])
  cota    Cota    @relation(fields: [cotaId], references: [id])

  @@unique([sorteioId, cotaId])
  @@map("acertos_sorteio")
}

model Premio {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String          @db.Uuid @map("tenant_id")
  bolaoId              String          @db.Uuid @map("bolao_id")
  cotaId               String          @db.Uuid @map("cota_id")
  categoriaPremiacaoId String          @db.Uuid @map("categoria_premiacao_id")
  valorTotalCategoria  Decimal         @db.Decimal(12, 2) @map("valor_total_categoria")
  valorPorGanhador     Decimal         @db.Decimal(12, 2) @map("valor_por_ganhador")
  statusPagamento      PagamentoStatus @default(PENDENTE) @map("status_pagamento")
  dataPagamento        DateTime?       @db.Timestamptz() @map("data_pagamento")
  criadoEm             DateTime        @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm         DateTime        @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  bolao              Bolao              @relation(fields: [bolaoId], references: [id])
  cota               Cota               @relation(fields: [cotaId], references: [id])
  categoriaPremiacao CategoriaPremiacao @relation(fields: [categoriaPremiacaoId], references: [id])

  @@map("premios")
}

model WhatsappTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  nome         String
  conteudo     String
  tipo         String   @default("MANUAL")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm DateTime @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_templates")
}

model MensagemWhatsapp {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @db.Uuid @map("tenant_id")
  bolaoId      String?        @db.Uuid @map("bolao_id")
  tipo         MensagemTipo
  conteudo     String
  grupoId      String?        @map("grupo_id")
  status       MensagemStatus @default(PENDENTE)
  tentativas   Int            @default(0)
  erro         String?
  criadoEm     DateTime       @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm DateTime       @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  bolao  Bolao? @relation(fields: [bolaoId], references: [id])

  @@map("mensagens_whatsapp")
}

// ── RBAC ─────────────────────────────────────────────────────

model Modulo {
  codigo        String        @id @db.VarChar(40)
  nome          String        @db.VarChar(80)
  descricao     String?
  ordem         Int           @default(0)
  apenasMaster  Boolean       @default(false) @map("apenas_master")
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now()) @db.Timestamptz() @map("criado_em")

  permissoes    Permissao[]
  modulosTenant ModuloTenant[]

  @@map("modulos")
}

model Permissao {
  codigo         String    @id @db.VarChar(80)
  moduloCodigo   String    @db.VarChar(40) @map("modulo_codigo")
  nome           String    @db.VarChar(120)
  descricao      String?
  apenasMaster   Boolean   @default(false) @map("apenas_master")
  criadoEm       DateTime  @default(now()) @db.Timestamptz() @map("criado_em")

  modulo            Modulo            @relation(fields: [moduloCodigo], references: [codigo])
  perfilPermissoes  PerfilPermissao[]

  @@index([moduloCodigo])
  @@map("permissoes")
}

model ModuloTenant {
  tenantId      String   @db.Uuid @map("tenant_id")
  moduloCodigo  String   @db.VarChar(40) @map("modulo_codigo")
  ativo         Boolean  @default(true)
  habilitadoEm  DateTime @default(now()) @db.Timestamptz() @map("habilitado_em")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  modulo Modulo @relation(fields: [moduloCodigo], references: [codigo])

  @@id([tenantId, moduloCodigo])
  @@index([tenantId])
  @@map("modulos_tenant")
}

model Perfil {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid @map("tenant_id")
  nome          String    @db.VarChar(80)
  descricao     String?
  prioridade    Int       @default(0)
  ativo         Boolean   @default(true)
  sistema       Boolean   @default(false)
  criadoEm      DateTime  @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm  DateTime  @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  permissoes     PerfilPermissao[]
  usuarios       UsuarioPerfil[]

  @@unique([tenantId, nome], map: "perfis_nome_unico_por_tenant")
  @@index([tenantId])
  @@map("perfis")
}

model PerfilPermissao {
  perfilId        String @db.Uuid @map("perfil_id")
  permissaoCodigo String @db.VarChar(80) @map("permissao_codigo")

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoCodigo], references: [codigo], onDelete: Cascade)

  @@id([perfilId, permissaoCodigo])
  @@index([perfilId])
  @@index([permissaoCodigo])
  @@map("perfil_permissoes")
}

model UsuarioPerfil {
  userId        String   @db.Uuid @map("user_id")
  perfilId      String   @db.Uuid @map("perfil_id")
  atribuidoEm   DateTime @default(now()) @db.Timestamptz() @map("atribuido_em")
  atribuidoPor  String?  @db.Uuid @map("atribuido_por")

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([userId, perfilId])
  @@index([userId])
  @@index([perfilId])
  @@map("usuario_perfis")
}

model Auditoria {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?             @db.Uuid @map("tenant_id")
  userId      String?             @db.Uuid @map("user_id")
  userEmail   String?             @db.VarChar(255) @map("user_email")
  acao        String              @db.VarChar(80)
  recurso     String?             @db.VarChar(40)
  recursoId   String?             @db.Uuid @map("recurso_id")
  severidade  AuditoriaSeveridade @default(INFO)
  detalhes    Json                @default("{}")
  ip          String?             @db.Inet
  userAgent   String?             @map("user_agent")
  criadoEm    DateTime            @default(now()) @db.Timestamptz() @map("criado_em")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, criadoEm(sort: Desc)], map: "idx_auditoria_tenant_data")
  @@index([userId])
  @@index([acao])
  @@index([recurso, recursoId])
  @@map("auditoria")
}

// ── CRM ────────────────────────────────────────────────────────

model CrmEtapa {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  nome      String
  cor       String   @default("#64748b")
  ordem     Int      @default(0)
  isSistema Boolean  @default(false) @map("is_sistema")
  criadoEm  DateTime @default(now()) @db.Timestamptz() @map("criado_em")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  contatos CrmContato[]

  @@unique([tenantId, nome])
  @@index([tenantId, ordem])
  @@map("crm_etapas")
}

model CrmContato {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  celular        String
  nome           String?
  etapaId        String?  @db.Uuid @map("etapa_id")
  tags           String[] @default([])
  notas          String?
  participanteId String?  @db.Uuid @map("participante_id")
  criadoEm       DateTime @default(now()) @db.Timestamptz() @map("criado_em")
  atualizadoEm   DateTime @default(now()) @db.Timestamptz() @map("atualizado_em")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  etapa        CrmEtapa?     @relation(fields: [etapaId], references: [id])
  participante Participante? @relation(fields: [participanteId], references: [id])

  @@unique([tenantId, celular])
  @@index([tenantId])
  @@index([etapaId])
  @@map("crm_contatos")
}

model CrmMensagem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  celular     String
  direcao     String   @default("OUT")
  conteudo    String
  tipo        String   @default("text")
  lida        Boolean  @default(false)
  waMessageId String?  @map("wa_message_id")
  enviadaPor  String?  @db.Uuid @map("enviada_por")
  criadoEm    DateTime @default(now()) @db.Timestamptz() @map("criado_em")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, celular, criadoEm(sort: Desc)])
  @@map("crm_mensagens")
}

model MegaResultado {
  id                      Int      @id @default(autoincrement())
  numeroConcurso          Int      @unique @map("numero_concurso")
  dataSorteio             DateTime @db.Date @map("data_sorteio")
  bolasSorteadas          Int[]    @map("bolas_sorteadas")
  ganhadores              Int      @default(0) @map("ganhadores_sena")
  acumulado               Boolean  @default(false)
  valorArrecadado         Float?   @map("valor_arrecadado")
  estimativaProximo       Float?   @map("estimativa_proximo")
  dataProximoConcurso     String?  @map("data_proximo_concurso")
  numeroConcursoProximo   Int?     @map("numero_concurso_proximo")
  criadoEm               DateTime @default(now()) @db.Timestamptz() @map("criado_em")

  @@map("mega_resultados")
}
